[debug] [2026-03-20T19:56:39.032Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/safezone-cd4b5/rulesets {"name":"projects/safezone-cd4b5/rulesets/8714883d-e7a6-4aa3-b3b9-0f817ead9da0","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // אפליקציית SafeZone: tokens של משתמשים\n    // כל מכשיר יכול לקרוא ולכתוב את ה-token שלו\n    match /tokens/{tokenId} {\n      allow read, write: if true;\n    }\n\n    // _meta: מצב האזעקה הנוכחית\n    // נדרש לקריאה מהאפליקציה ולכתיבה מ-Cloud Functions\n    match /_meta/{docId} {\n      allow read, write: if true;\n    }\n\n    // חסום כל שאר הגישות\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-03-20T19:56:40.037823Z","metadata":{"services":["cloud.firestore"]}}
