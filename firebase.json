{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".gitignore",
      "functions/**",
      "node_modules/**",
      "firestore.rules",
      "firestore.indexes.json"
    ],
    "rewrites": [
      {
        "source": "/api/sendManualAlert",
        "function": { "functionId": "sendManualAlert", "region": "me-west1" }
      },
      {
        "source": "/api/version",
        "function": { "functionId": "version", "region": "me-west1" }
      },
      {
        "source": "/api/schedulerLogs",
        "function": { "functionId": "schedulerLogs", "region": "me-west1" }
      },
      {
        "source": "/api/runCheck",
        "function": { "functionId": "runCheck", "region": "me-west1" }
      },
      {
        "source": "/api/diagnose",
        "function": { "functionId": "diagnose", "region": "me-west1" }
      },
      {
        "source": "/api/proxyLogs",
        "function": { "functionId": "proxyLogs", "region": "me-west1" }
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "firebase-messaging-sw.js",
        "headers": [
          { "key": "Service-Worker-Allowed", "value": "/" },
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "manifest.json",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  }
}
